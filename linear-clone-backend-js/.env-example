# Database
DATABASE_URL=postgresql://user:password@localhost:5432/linear_clone

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-secret-key-min-32-chars-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# App
NODE_ENV=development
PORT=3000

# CORS (comma-separated origins, or * for dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting (requests per minute per IP)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=3
SESSION_LIMIT=10
RATE_LIMIT_SESSION_LIST=30
RATE_LIMIT_SESSION_REVOKE=30
RATE_LIMIT_SESSION_REVOKE_ALL=10

# WebSocket Gateway
# WS_PORT=0 (0 = same port as HTTP server)
# WS_AUTH_TIMEOUT_MS=5000
# WS_MAX_CONNECTIONS=1000